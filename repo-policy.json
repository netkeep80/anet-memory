{
  "policy_format_version": "0.3.0",
  "repository_kind": "tooling",
  "enforcement": {
    "mode": "advisory"
  },
  "paths": {
    "forbidden": [
      "legacy/**",
      "archive/**",
      "old/**",
      "*.bak",
      "*.tmp",
      "*.orig"
    ],
    "canonical_docs": [
      "README.md"
    ],
    "governance_paths": [
      "repo-policy.json",
      ".github/workflows/repo-guard.yml",
      ".github/PULL_REQUEST_TEMPLATE.md"
    ],
    "operational_paths": []
  },
  "diff_rules": {
    "max_new_docs": 4,
    "max_new_files": 20,
    "max_net_added_lines": 2500
  },
  "content_rules": [],
  "cochange_rules": []
}
